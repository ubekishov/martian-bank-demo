# Martian Bank — dashboard (Flask :5000)
# Copy to .env: scripts/setup_local.sh [--docker|--native]

# MongoDB (required)
DB_URL=mongodb://root:example@mongo:27017

# Backend protocol: http or grpc
SERVICE_PROTOCOL=http

# Downstream microservice hosts (Docker Compose service names)
ACCOUNT_HOST=accounts
TRANSACTION_HOST=transactions
LOAN_HOST=loan
CUSTOMER_AUTH_HOST=customer-auth
ATM_LOCATOR_HOST=atm-locator

# Native: use localhost for all *HOST vars and DB_URL=mongodb://localhost:27017
