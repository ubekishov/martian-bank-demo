# Martian Bank — customer-auth
# Copy to .env: scripts/setup_local.sh [--docker|--native]
#
# Native (no auth): set DATABASE_HOST=localhost and comment out DB_URL.
# Docker Compose: DB_URL uses service hostname "mongo" (see setup_local.sh).

PORT=8000
JWT_SECRET=martian-bank-dev-secret-change-me

# Docker Compose (default in setup_local.sh --docker)
DB_URL=mongodb://root:example@mongo:27017

# Native local MongoDB (setup_local.sh --native)
# DATABASE_HOST=localhost
